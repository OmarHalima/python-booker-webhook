# v1.0.1 sandbox — copy to python/.env (or symlink from repo root .env)
#
# Full variable reference: ../../../.env.example
# Run: cd sandboxes/v1.0.1 && python scripts/start_booker.py  (port 8011)

CAPTCHA_OCR_BASE_URL=http://127.0.0.1:8001
GEMINI_API_KEY=your_gemini_api_key_here
CAPTCHA_SOLVER=ocr_with_gemini_fallback
CAPTCHA_PARALLEL_FETCH=false
CAPTCHA_OCR_ENHANCE=false
CAPTCHA_MAX_STYLE_RELOADS=0
CAPTCHA_MIN_STYLE=easy
CAPTCHA_KEYSTROKE_DELAY_MS=20
BOTDETECT_SETTLE_MS=150
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_REUSE_BROWSER=true
