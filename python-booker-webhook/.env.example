# VPS OCR captcha (anuashok/ocr-captcha-v3) — primary solver; ngrok needs ngrok-skip-browser-warning (set in code)
CAPTCHA_OCR_BASE_URL=https://your-ocr-host.example
CAPTCHA_OCR_TIMEOUT=30
# ocr_with_gemini_fallback (default) | ocr | gemini
CAPTCHA_SOLVER=ocr_with_gemini_fallback
# Artifact folder id when payload omits runId: sequential (run-000001…) or uuid
RUN_ID_MODE=sequential
RUN_ID_SEQ_WIDTH=6

# --- Playwright navigation / form waits (milliseconds unless noted) ---
# Reservation-for: select appear + option poll (seconds)
CALENDAR_OPTIONS_WAIT_SEC=10
CALENDAR_OPTIONS_POLL_MS=400
# Passport/captcha capture form (#Token, #StartTime, #BDC_VCID_Captcha)
FORM_LOAD_TIMEOUT_MS=15000
# ASP.NET postback shell (title "Loading…") — per Next click
POSTBACK_SETTLE_TIMEOUT_MS=60000
POSTBACK_STUCK_RELOAD_MAX=1
# After each Next / submit
NAV_DOM_CONTENT_LOADED_MS=20000
NAV_NETWORK_IDLE_MS=12000
NAV_SETTLE_DOM_MS=25000
SELECT_OPTION_TIMEOUT_MS=8000
PERSON_COUNT_WAIT_MS=30000
INFORMATION_PAGE_WAIT_MS=35000
CHOOSE_APPOINTMENT_WAIT_MS=60000
START_RADIOS_WAIT_MS=25000
SUBMIT_NEXT_CLICK_MS=8000
SUBMIT_NEXT_NAVIGATION_MS=45000
CAPTCHA_FIELD_CLICK_MS=15000

# true = no display/Xvfb needed; false = headed browser (default, better for captcha debugging).
PLAYWRIGHT_HEADLESS=false
# Playwright sync API is not thread-safe — keep 1 per uvicorn process; scale with --workers N.
# Max parallel bookings = (uvicorn --workers) × MAX_CONCURRENT_BOOKINGS (e.g. 3×1=3).
MAX_CONCURRENT_BOOKINGS=1
# One booking at a time on the whole VPS (required for stable loads; parallel = blank "Loading…" page).
BOOKING_USE_GLOBAL_LOCK=true
# Initial page.goto + wait for #Office (ms). Retries: LANDING_GOTO_MAX_ATTEMPTS.
LANDING_GOTO_TIMEOUT_MS=45000
LANDING_READY_TIMEOUT_MS=45000
LANDING_GOTO_MAX_ATTEMPTS=3
# Seconds to wait for global lock / per-worker slot before HTTP 503 (n8n must retry, not parallel-fire).
BOOKING_SLOT_WAIT_SEC=15
BOOKING_BUSY_RETRY_AFTER_SEC=60
# networkidle often stalls ASP.NET Next steps; domcontentloaded is usually enough.
PLAYWRIGHT_WAIT_NETWORK_IDLE=false
# Playwright delay per action (ms); 0 is faster. Default 80.
PLAYWRIGHT_SLOW_MO=80
# false (default): fail if currentSlot not on choose-appointment page (no silent first-radio book).
BOOKING_ALLOW_SLOT_FALLBACK=false
# true: all legacy bookings use POST /HomeWeb/Scheduler instead of full wizard (or set useSchedulerPost in payload).
BOOKING_DEFAULT_SCHEDULER_POST=false
# Turbo submit: browser (default, works) | http (lab — often CAPTCHA_FAIL). Also set submitMode in JSON payload.
TURBO_SUBMIT_MODE=browser
# Keystroke delay when typing captcha into #CaptchaText (ms). Default 35.
CAPTCHA_KEYSTROKE_DELAY_MS=35

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# After deterministic fill, use Gemini to fill fields still empty (default: true).
GEMINI_FILL_FORM=true
# If true, send every applicant field id on the page to Gemini once, merge, then re-fill (extra API call).
GEMINI_FILL_FORM_FORCE=false
