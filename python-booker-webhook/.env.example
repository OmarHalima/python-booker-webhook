# =============================================================================
# Austria Booker Webhook — environment configuration (template)
# Copy to .env and fill in secrets. Restart uvicorn after changes.
# =============================================================================

# --- Captcha OCR (primary solver) ---
# VPS OCR (anuashok/ocr-captcha-v3 style); ngrok-skip-browser-warning set in code
CAPTCHA_OCR_BASE_URL=https://your-ocr-host.example
CAPTCHA_OCR_TIMEOUT=30
# ocr_with_gemini_fallback (default) | ocr | gemini | gemini_first
CAPTCHA_SOLVER=ocr_with_gemini_fallback
# Turbo-specific override (optional). Unset = use CAPTCHA_SOLVER above.
# TURBO_CAPTCHA_SOLVER=ocr_with_gemini_fallback
# Preprocess captcha image before OCR (grayscale, CLAHE, Otsu). false = raw bytes (better for Gemini).
CAPTCHA_OCR_ENHANCE=false
# Keystroke delay when typing captcha into #CaptchaText (ms). Floor is 20ms.
CAPTCHA_KEYSTROKE_DELAY_MS=20
# Extra ms after BotDetect image visible before submit (default 150)
BOTDETECT_SETTLE_MS=150
# Style-gate: assess captcha difficulty and optionally reload before solving.
# 0 = disabled (recommended until reload logic is fixed). Min style: easy | medium | any
CAPTCHA_MAX_STYLE_RELOADS=0
CAPTCHA_MIN_STYLE=easy

# --- Gemini (captcha fallback + optional form fill) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# After deterministic fill, use Gemini to fill fields still empty
GEMINI_FILL_FORM=true
# If true, send every applicant field id to Gemini once (extra API call)
GEMINI_FILL_FORM_FORCE=false

# --- Run ID / artifacts ---
# Artifact folder id when payload omits runId: sequential (run-000001…) or uuid
RUN_ID_MODE=sequential
RUN_ID_SEQ_WIDTH=6

# --- Turbo booking (default path) ---
# browser (default, works) | http (lab — often CAPTCHA_FAIL). Also set submitMode in payload.
TURBO_SUBMIT_MODE=browser

# --- Booking concurrency / locking ---
# Playwright sync API is not thread-safe — keep 1 per uvicorn process; scale with --workers N
MAX_CONCURRENT_BOOKINGS=1
# One booking at a time on the whole VPS (parallel = blank "Loading…" page)
BOOKING_USE_GLOBAL_LOCK=true
# Seconds to wait for global lock / per-worker slot before HTTP 503
BOOKING_SLOT_WAIT_SEC=15
BOOKING_BUSY_RETRY_AFTER_SEC=60
# false: fail if currentSlot not on choose-appointment page (no silent first-radio book)
BOOKING_ALLOW_SLOT_FALLBACK=false
# true: legacy bookings use POST /HomeWeb/Scheduler instead of full wizard
BOOKING_DEFAULT_SCHEDULER_POST=false

# --- Playwright browser ---
# true = no display/Xvfb needed; false = headed (better for captcha debugging)
PLAYWRIGHT_HEADLESS=true
# Delay per Playwright action (ms). 0 is fastest.
PLAYWRIGHT_SLOW_MO=0
# Reuse a warm browser process across bookings to avoid repeated launches.
PLAYWRIGHT_REUSE_BROWSER=true
# Recycle warm browser after this many seconds.
PLAYWRIGHT_REUSE_MAX_AGE_SEC=1800
# Recycle warm browser after this many booking runs.
PLAYWRIGHT_REUSE_MAX_RUNS=100
# networkidle often stalls ASP.NET; domcontentloaded is usually enough
PLAYWRIGHT_WAIT_NETWORK_IDLE=false

# --- Parallel captcha fetch (v1.0.1+ pipeline) ---
# Code hard-disables parallel URL fetch for solving (always DOM screenshot).
# CAPTCHA_PARALLEL_FETCH env is ignored by booker_legacy.captcha_parallel_fetch_enabled().
# Kept here for documentation only — do not enable expecting it to work.
CAPTCHA_PARALLEL_FETCH=false

# --- Playwright navigation / form waits (milliseconds unless noted) ---
# Reservation-for: select appear + option poll (seconds)
CALENDAR_OPTIONS_WAIT_SEC=10
CALENDAR_OPTIONS_POLL_MS=400
# Passport/captcha capture form (#Token, #StartTime, #BDC_VCID_Captcha)
FORM_LOAD_TIMEOUT_MS=15000
# ASP.NET postback shell (title "Loading…") — per Next click
POSTBACK_SETTLE_TIMEOUT_MS=60000
POSTBACK_STUCK_RELOAD_MAX=1
# After each Next / submit
NAV_DOM_CONTENT_LOADED_MS=20000
NAV_NETWORK_IDLE_MS=12000
NAV_SETTLE_DOM_MS=25000
SELECT_OPTION_TIMEOUT_MS=8000
PERSON_COUNT_WAIT_MS=30000
INFORMATION_PAGE_WAIT_MS=35000
CHOOSE_APPOINTMENT_WAIT_MS=60000
START_RADIOS_WAIT_MS=25000
SUBMIT_NEXT_CLICK_MS=8000
SUBMIT_NEXT_NAVIGATION_MS=45000
CAPTCHA_FIELD_CLICK_MS=15000
# Initial page.goto + wait for #Office (ms). Retries: LANDING_GOTO_MAX_ATTEMPTS
LANDING_GOTO_TIMEOUT_MS=45000
LANDING_READY_TIMEOUT_MS=45000
LANDING_GOTO_MAX_ATTEMPTS=3
