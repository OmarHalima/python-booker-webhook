# Local secrets for n8n API + ngrok (copy to .env.n8n.local — never commit)
# Used by implementation scripts / manual curl — see docs/N8N_BOOKER_LOCK_IMPLEMENTATION_PLAN.md

# n8n Enterprise public API (JWT from Settings → API)
N8N_API_BASE_URL=https://n8n.acmeai.crabdance.com
N8N_API_KEY=

# ngrok (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# After ngrok start — booker HTTP node target (update when tunnel restarts)
BOOKER_PUBLIC_URL=
