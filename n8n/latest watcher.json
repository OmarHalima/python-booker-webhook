    {
      "parameters": {
        "jsCode": "// Parse HTML response and extract slots + session cookie\nconst response = $input.first().json;\nconst html = response.body || response.data || '';;\n\n// Extract fresh session cookie from this response if present\nlet sessionCookie = $('Init Week State').first().json.sessionCookie;\nconst headers = response.headers || {};\nconst setCookie = headers['set-cookie'] || headers['Set-Cookie'];\nif (setCookie) {\n  const cookieStr = Array.isArray(setCookie) ? setCookie.join('; ') : setCookie;\n  const match = cookieStr.match(/ASP\\.NET_SessionId=([^;,\\s]+)/);\n  if (match) {\n    sessionCookie = `AspxAutoDetectCookieSupport=1; ASP.NET_SessionId=${match[1]}`;\n  }\n}\n\nconst state = $('Init Week State').first().json;\n\n// Find available slots\nconst slotRegex = /name=\"Start\"\\s+type=\"radio\"\\s+value=\"([^\"]+)\"|name=\"Start\"[^>]+value=\"([^\"]+)\"/gi;\nconst slots = [];\nlet m;\nwhile ((m = slotRegex.exec(html)) !== null) {\n  slots.push(decodeURIComponent(m[1] || m[2]));\n}\n\n// Check navigation buttons\nconst hasNextWeek = html.includes('value=\"Next week\"');\nconst hasBack = html.includes('value=\"Back\"');\n\n// Extract week label — format: \"Week M/D/YYYY - M/D/YYYY\"\nconst weekMatch = html.match(/Week\\s+([\\d]{1,2}\\/[\\d]{1,2}\\/[\\d]{4}\\s*-\\s*[\\d]{1,2}\\/[\\d]{1,2}\\/[\\d]{4})/);\nconst weekLabel = weekMatch ? weekMatch[1].trim() : 'unknown';\n\n// Extract Monday hidden input value (what the server thinks is current Monday)\nconst mondayMatch = html.match(/name=\"Monday\"[^>]*value=\"([^\"]+)\"/);\nconst currentMonday = mondayMatch ? mondayMatch[1] : state.currentMonday;\n\n// Extract Token\nconst tokenMatch = html.match(/name=\"Token\"[^>]*value=\"([^\"]+)\"/);\nconst token = tokenMatch ? tokenMatch[1] : null;\n\n// Extract error message\nconst hasError = html.includes('no appointments available');\n\nconst isDone = slots.length > 0 || !hasNextWeek || (state.weekIndex + 1) >= state.MaxWeeksToScan;\n\nconsole.log(`Week: ${weekLabel} | Monday: ${currentMonday} | Slots: ${slots.length} | hasNextWeek: ${hasNextWeek} | done: ${isDone}`);\n\nreturn [{\n  json: {\n    ...state,\n    sessionCookie,\n    weekIndex: state.weekIndex + 1,\n    currentMonday,\n    weekLabel,\n    slotsFound: slots.length > 0,\n    foundSlots: slots,\n    hasNextWeek,\n    hasError,\n    token,\n    done: isDone\n  }\n}];"
      },
