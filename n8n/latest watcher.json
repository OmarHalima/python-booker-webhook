    {
      "parameters": {
        "jsCode": "const prevData = $('Prepare Notification').first().json;\nconst response = $input.first().json;\nconst html = response.body || response.data || '';\n\nconst vcidMatch = html.match(/name=\"BDC_VCID_Captcha\"[^>]+value=\"([^\"]+)\"/);\nconst hsMatch = html.match(/name=\"BDC_Hs_Captcha\"[^>]+value=\"([^\"]+)\"/);\nconst spMatch = html.match(/name=\"BDC_SP_Captcha\"[^>]+value=\"([^\"]+)\"/);\nconst bwMatch = html.match(/name=\"BDC_BackWorkaround_Captcha\"[^>]+value=\"([^\"]+)\"/);\n\nconst BDC_VCID = vcidMatch ? vcidMatch[1] : null;\nconst BDC_Hs = hsMatch ? hsMatch[1] : null;\nconst BDC_SP = spMatch ? spMatch[1] : null;\nconst BDC_BW = bwMatch ? bwMatch[1] : '0';\n\nconst tokenMatch = html.match(/id=\"Token\"[^>]+value=\"([^\"]+)\"/);\nconst token = tokenMatch ? tokenMatch[1] : prevData.token;\n\nconst startTimeMatch = html.match(/id=\"StartTime\"[^>]+value=\"([^\"]+)\"/);\nconst startTime = startTimeMatch ? startTimeMatch[1] : prevData.firstSlot;\n\n// Extract form action endpoint (differs between visa types)\nconst actionMatch = html.match(/form action=\"([^\"]+)\"/);\nconst formAction = actionMatch ? actionMatch[1] : '/HomeWeb/Appointment';\nconst bookingEndpoint = `https://appointment.bmeia.gv.at${formAction}`;\n\nconst captchaImageUrl = BDC_VCID\n  ? `https://appointment.bmeia.gv.at/BotDetectCaptcha.ashx?get=image&c=Captcha&t=${BDC_VCID}`\n  : null;\n\nif (!BDC_VCID) {\n  console.warn('Could not extract CAPTCHA VCID — booking page may not have loaded correctly');\n}\n\nreturn [{\n  json: {\n    ...prevData,\n    token,\n    startTime,\n    BDC_VCID_Captcha: BDC_VCID,\n    BDC_Hs_Captcha: BDC_Hs,\n    BDC_SP_Captcha: BDC_SP,\n    BDC_BackWorkaround_Captcha: BDC_BW,\n    captchaImageUrl,\n    bookingEndpoint,\n    bookingFormReady: !!BDC_VCID\n  }\n}];"
      },
