    {
      "parameters": {
        "jsCode": "// Parse next-week HTML - same logic as Parse HTML for Slots\nconst prevState = $('Parse HTML for Slots').first().json;\nconst httpResponse = $input.first().json;\nconst html = httpResponse.body || '';\n\nlet sessionCookie = prevState.sessionCookie;\n\nconst slotRegex = /name=\"Start\"\\s+type=\"radio\"\\s+value=\"([^\"]+)\"|name=\"Start\"[^>]+value=\"([^\"]+)\"/gi;\nconst slots = [];\nlet m;\nwhile ((m = slotRegex.exec(html)) !== null) {\n  slots.push(decodeURIComponent(m[1] || m[2]));\n}\n\nconst hasNextWeek = html.includes('value=\"Next week\"');\nconst weekMatch = html.match(/Week\\s+([\\d]{1,2}\\/[\\d]{1,2}\\/[\\d]{4}\\s*-\\s*[\\d]{1,2}\\/[\\d]{1,2}\\/[\\d]{4})/);\nconst weekLabel = weekMatch ? weekMatch[1].trim() : 'unknown';\nconst mondayMatch = html.match(/name=\"Monday\"[^>]*value=\"([^\"]+)\"/);\nconst currentMonday = mondayMatch ? mondayMatch[1] : prevState.currentMonday;\nconst tokenMatch = html.match(/name=\"Token\"[^>]*value=\"([^\"]+)\"/);\nconst token = tokenMatch ? tokenMatch[1] : null;\nconst hasError = html.includes('no appointments available');\n\nconst isDone = slots.length > 0 || !hasNextWeek || (prevState.weekIndex + 1) >= prevState.MaxWeeksToScan;\n\nconsole.log(`Week: ${weekLabel} | Monday: ${currentMonday} | Slots: ${slots.length} | hasNextWeek: ${hasNextWeek} | done: ${isDone}`);\n\nreturn [{\n  json: {\n    ...prevState,\n    sessionCookie,\n    weekIndex: prevState.weekIndex + 1,\n    currentMonday,\n    weekLabel,\n    slotsFound: slots.length > 0,\n    foundSlots: slots,\n    hasNextWeek,\n    hasError,\n    token,\n    done: isDone\n  }\n}];"
      },
