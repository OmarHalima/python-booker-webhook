      "parameters": {
        "jsCode": "// Format a rich notification message with all slot details\nconst data = $input.first().json;\n\nconst slotList = data.foundSlots\n  .map((s, i) => `${i+1}. ${s}`)\n  .join('\\n');\n\nconst message = [\n  '🇦🇹 APPOINTMENT SLOT AVAILABLE!',\n  '',\n  `Office: ${data.Office}`,\n  `Calendar ID: ${data.CalendarId}`,\n  `Week: ${data.weekLabel}`,\n  '',\n  `Available slots (${data.foundSlots.length}):`,\n  slotList,\n  '',\n  `Session Cookie: ${data.sessionCookie}`,\n  `Token: ${data.token || 'N/A'}`,\n  '',\n  'Act NOW — these slots disappear in seconds!',\n  `Time detected: ${new Date().toISOString()}`\n].join('\\n');\n\nconst shortMessage = `🇦🇹 SLOTS AVAILABLE NOW!\\n${data.foundSlots.length} slot(s) at ${data.weekLabel}\\nFirst slot: ${data.foundSlots[0]}`;\n\nreturn [{\n  json: {\n    ...data,\n    notificationMessage: message,\n    telegramMessage: shortMessage,\n    firstSlot: data.foundSlots[0],\n    detectedAt: new Date().toISOString()\n  }\n}];"
