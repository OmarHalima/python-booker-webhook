      "parameters": {
        "jsCode": "const config = $('Config').first().json;\nconst required = String(config.CalendarId || '').trim();\nconst slotData = $('Merge Results').first().json;\n\nconst raw = $input.first().json;\nconst html = String(\n  raw.data ?? raw.body ?? raw.html ?? (typeof raw === 'string' ? raw : '')\n);\n\nconst options = [];\nconst re = /<option\\s+value=\"(\\d+)\"[^>]*>([^<]*)<\\/option>/gi;\nlet m;\nwhile ((m = re.exec(html)) !== null) {\n  options.push({ value: m[1], text: m[2].trim() });\n}\n\nconst calendarLive = required !== '' && options.some(o => o.value === required);\n\nconsole.log(\n  `CalendarId UI check: required=${required} live=${calendarLive} options=${options.length}`\n);\n\nreturn [{\n  json: {\n    ...slotData,\n    calendarLive,\n    calendarOptionsCount: options.length\n  }\n}];"
      },
